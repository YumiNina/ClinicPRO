PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

FRONTEND_URL=http://localhost:5174
# Comma-separated list for production CORS. Include the public frontend URL.
ALLOWED_ORIGINS=http://localhost:5174

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Required for TypeORM and for applying/seeding SQL from npm scripts.
# Direct connection format:
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# If the direct host does not resolve in your network, use the Supabase pooler instead:
# DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Optional external/internal service used when cancelled appointments are sent to history.
HISTORIAL_API_URL=http://historial-service:3002/api
