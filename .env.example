# ClinicPRO root environment reference for final defense.
# Do not paste real secrets into this file. Configure real values in backend/.env,
# frontend/.env, the cloud platform dashboard, or GitHub Secrets.

# Public demo URLs. Keep as pending until the services are actually deployed.
PUBLIC_FRONTEND_URL=PENDIENTE_DE_CONFIGURAR
PUBLIC_BACKEND_URL=PENDIENTE_DE_CONFIGURAR

# Backend runtime configuration.
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5174

# Backend secrets. Replace only in local/cloud secret storage.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Supabase / database configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Optional service integration.
HISTORIAL_API_URL=http://historial-service:3002/api

# Frontend public build-time configuration. These are public URLs, not secrets.
VITE_API_AUTH=http://localhost:3001/api
VITE_API_CITAS=http://localhost:3001/api
VITE_API_HISTORIAL=http://localhost:3001/api
